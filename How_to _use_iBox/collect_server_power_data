from pathlib import Path

import pandas as pd
from influxdb_client import InfluxDBClient


# =========================
# InfluxDB 連線設定
# =========================
INFLUX_URL = "http://192.168.8.48:8086"
INFLUX_TOKEN = "NsoS0TaoZaPwf7wn4ZMiXqPc4jYL2IDoLrCU-6L0Tx4NeuqyXHhrA_c6wuuu2NZQHE8ShACoWLe4QVhDXVamyw=="
INFLUX_ORG = "bmwlab"
INFLUX_BUCKET = "cortexdc_server"


# =========================
# Flux 查詢
# 2026-07-17 01:00 ~ 2026-07-18 01:00
# 台灣時間 UTC+8
# 每 1 分鐘取平均
# =========================
query = f'''
from(bucket: "{INFLUX_BUCKET}")
  |> range(
      start: 2026-07-17T01:00:00+08:00,
      stop: 2026-07-18T01:00:00+08:00
  )
  |> filter(fn: (r) =>
      r["_measurement"] == "server_power"
  )
  |> filter(fn: (r) =>
      r["_field"] == "average_consumed_watts" or
      r["_field"] == "max_consumed_watts" or
      r["_field"] == "min_consumed_watts" or
      r["_field"] == "power_available_watts" or
      r["_field"] == "power_capacity_watts" or
      r["_field"] == "power_consumed_watts" or
      r["_field"] == "power_limit_watts"
  )
  |> aggregateWindow(
      every: 1m,
      fn: mean,
      createEmpty: false
  )
  |> sort(columns: ["_time"])
'''


def main() -> None:
    try:
        with InfluxDBClient(
            url=INFLUX_URL,
            token=INFLUX_TOKEN,
            org=INFLUX_ORG,
            timeout=300_000,
        ) as client:

            print("正在查詢 Server Power 資料……")

            result = client.query_api().query_data_frame(
                query=query,
                org=INFLUX_ORG,
            )

        if isinstance(result, list):
            frames = [
                frame
                for frame in result
                if frame is not None and not frame.empty
            ]

            if not frames:
                print("查詢成功，但指定時間內沒有資料。")
                return

            data = pd.concat(frames, ignore_index=True)

        else:
            data = result

        if data is None or data.empty:
            print("查詢成功，但指定時間內沒有資料。")
            return

        # 移除 InfluxDB 輔助欄位
        remove_columns = [
            "result",
            "table",
            "_start",
            "_stop",
        ]

        data = data.drop(
            columns=[
                column
                for column in remove_columns
                if column in data.columns
            ]
        )

        # 將時間轉成台灣時間
        if "_time" in data.columns:
            data["_time"] = pd.to_datetime(
                data["_time"],
                utc=True,
            ).dt.tz_convert("Asia/Taipei")

        # 排序
        sort_columns = [
            column
            for column in [
                "_time",
                "server_name",
                "_field",
            ]
            if column in data.columns
        ]

        if sort_columns:
            data = data.sort_values(sort_columns)

        output_path = Path(
            "server_power_2026-07-17_0100_to_2026-07-18_0100.csv"
        )

        data.to_csv(
            output_path,
            index=False,
            encoding="utf-8-sig",
        )

        print("下載完成")
        print(f"CSV 路徑：{output_path.resolve()}")
        print(f"資料筆數：{len(data)}")

        print("\n欄位名稱：")
        print(data.columns.tolist())

        print("\n前 5 筆資料：")
        print(data.head())

    except Exception as error:
        print("下載失敗")
        print("錯誤類型：", type(error).__name__)
        print("錯誤內容：", error)


if __name__ == "__main__":
    main()
